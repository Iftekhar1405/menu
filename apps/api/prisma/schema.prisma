// Menu Platform — Phase 1 schema.
//
// Two rules drive the shape here:
//  1. Every tenant-owned row carries `businessId` directly, even where it
//     could be reached by a join. Isolation filters and RLS policies stay
//     single-column predicates — the kind that are hard to get wrong.
//  2. Price lives at whichever level actually carries it. An item priced by
//     size has `price = null` and real prices on its variants. A constraint
//     trigger (see migration) guarantees one or the other is always present.

generator client {
  provider = "prisma-client-js"
  // "native" keeps local dev working; the rhel target is the one Vercel's
  // Amazon Linux 2023 runtime loads. Without it the deployed function starts
  // fine and then fails on the first query, which is the worst way to find out.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Vercel this must be Supabase's transaction pooler
  // (port 6543, ?pgbouncer=true): a serverless instance opens a connection per
  // cold start, and direct connections run out long before traffic does. The
  // RLS session is set with set_config(..., true), which is transaction-scoped,
  // so transaction pooling does not break isolation.
  url      = env("DATABASE_URL")
  // Migrations and introspection need a real session (port 5432); the pooler
  // cannot run them. Point both at the same direct URL for local dev.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  owner
  platform_admin
}

enum BusinessType {
  restaurant
  cafe
  theatre
}

enum DietTag {
  veg
  non_veg
  vegan
  egg
}

enum OtpPurpose {
  verify
  recover
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String?   @unique
  /// E.164, e.g. +919876543210
  phone          String?   @unique
  /// argon2id. Six digits, hashed — never the PIN itself.
  pinHash        String    @map("pin_hash")
  fullName       String    @map("full_name")
  role           UserRole  @default(owner)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  businesses     Business[]
  otpChallenges  OtpChallenge[]
  refreshTokens  RefreshToken[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  purpose    OtpPurpose
  /// argon2id of the 6-digit code. One code per challenge, fanned out to
  /// every channel the account has.
  codeHash   String     @map("code_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// sha256 of the opaque token. Rotated on every refresh.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Business {
  id           String       @id @default(uuid()) @db.Uuid
  ownerId      String       @map("owner_id") @db.Uuid
  name         String
  type         BusinessType
  logoPath     String?      @map("logo_path")

  addressLine1 String?      @map("address_line1")
  addressLine2 String?      @map("address_line2")
  city         String?
  state        String?
  postalCode   String?      @map("postal_code")
  country      String       @default("IN")

  /// Permanent, opaque, never editable — printed QR cards depend on it.
  publicCode   String       @unique @map("public_code")
  /// Renameable vanity URL that redirects to publicCode.
  vanitySlug   String?      @unique @map("vanity_slug")

  currency     String       @default("INR")

  themeLayout  String       @default("editorial") @map("theme_layout")
  themeAccent  String       @default("#1D6F5C") @map("theme_accent")
  themeFont    String       @default("inter-fraunces") @map("theme_font")

  /// Phase 3: post-order Google review deep link.
  googlePlaceId String?     @map("google_place_id")

  // ── Billing ──────────────────────────────────────────────────────────────
  taxEnabled          Boolean @default(false) @map("tax_enabled")
  /// Display only. The receipt is not a GST tax invoice — see the Phase 3 spec.
  taxLabel            String  @default("GST") @map("tax_label")
  defaultTaxRate      Decimal @default(5.00) @map("default_tax_rate") @db.Decimal(5, 2)
  /// Defaults true because that is how most Indian menus are priced, and the
  /// wrong default in this direction overcharges every diner on every bill.
  pricesIncludeTax    Boolean @default(true) @map("prices_include_tax")
  gstin               String? @map("gstin")
  /// Off by default: an automatic service charge is not permitted under the
  /// 2022 CCPA guidelines, and the diner can remove it from their bill.
  serviceChargeEnabled Boolean @default(false) @map("service_charge_enabled")
  serviceChargeRate    Decimal @default(0) @map("service_charge_rate") @db.Decimal(5, 2)
  receiptFooter        String? @map("receipt_footer")

  // ── Running orders ───────────────────────────────────────────────────────
  /// A table that orders again this soon after being served is mid-meal, and
  /// its new order is flagged and sorted to the top of the board. Decided by
  /// `place_table_round` when the order row is created — see the migration.
  runningOrderEnabled    Boolean @default(true) @map("running_order_enabled")
  /// Minutes, 5–180 (checked in the database). Roughly a starters-then-mains
  /// gap by default.
  runningOrderWindowMins Int     @default(45) @map("running_order_window_mins")

  // ── Cancelling an order ──────────────────────────────────────────────────
  /// Off by default. A kitchen that has already started cooking is the norm,
  /// so letting a diner call an order back is something an owner opts into
  /// rather than something they have to discover and switch off.
  cancellationEnabled      Boolean       @default(false) @map("cancellation_enabled")
  /// Minutes, measured from when each line was ordered rather than from the
  /// order — otherwise a second round would quietly reopen the first.
  cancellationWindowMins   Int           @default(2) @map("cancellation_window_mins")
  /// Which board columns still allow it. Empty means nobody can cancel, which
  /// is a coherent thing for an owner to have ticked their way into.
  cancellationStatuses     OrderStatus[] @default([placed]) @map("cancellation_statuses")
  /// Whether a diner may drop a single dish, or only the whole order.
  cancellationItemsEnabled Boolean       @default(true) @map("cancellation_items_enabled")

  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Bumped on every menu mutation; drives public payload cache busting.
  menuUpdatedAt DateTime    @default(now()) @map("menu_updated_at") @db.Timestamptz(6)

  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories MenuCategory[]
  items      MenuItem[]
  views      MenuView[]
  tables     Table[]
  orders     Order[]
  orderEvents OrderEvent[]
  bills      Bill[]
  ratings    OrderRating[]
  prompts    ReviewPrompt[]
  merchOrders MerchOrder[]
  notifications Notification[]
  cancellations OrderItemCancellation[]

  @@index([ownerId])
  @@map("businesses")
}

model MenuCategory {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  position   Int
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    MenuItem[]

  @@index([businessId, position])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  /// Denormalised from the category on purpose — see file header.
  businessId   String   @map("business_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  /// Null when priced by variant. Guarded by menu_item_price_guard.
  price        Decimal? @db.Decimal(10, 2)
  description  String?
  isAvailable  Boolean  @default(true) @map("is_available")
  position     Int

  // ── Advanced details: every field optional, hidden behind a disclosure ──
  dietTag      DietTag? @map("diet_tag")
  spiceLevel   Int?     @map("spice_level")
  prepTimeMins Int?     @map("prep_time_mins")
  ingredients  String?
  allergens    String[] @default([])
  nutrition    Json?
  /// Overrides the business default. Packaged goods are not taxed at the same
  /// rate as prepared food, and a single business rate bills one of them wrong.
  taxRate      Decimal? @map("tax_rate") @db.Decimal(5, 2)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants MenuItemVariant[]
  photos   MenuItemPhoto[]

  @@index([businessId])
  @@index([categoryId, position])
  @@map("menu_items")
}

model MenuItemVariant {
  id       String  @id @default(uuid()) @db.Uuid
  itemId   String  @map("item_id") @db.Uuid
  /// Carried for isolation queries, same reasoning as MenuItem.
  businessId String @map("business_id") @db.Uuid
  name     String
  price    Decimal @db.Decimal(10, 2)
  position Int

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
  @@index([businessId])
  @@map("menu_item_variants")
}

model MenuItemPhoto {
  id          String  @id @default(uuid()) @db.Uuid
  itemId      String  @map("item_id") @db.Uuid
  businessId  String  @map("business_id") @db.Uuid
  storagePath String  @map("storage_path")
  alt         String?
  position    Int

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
  @@index([businessId])
  @@map("menu_item_photos")
}

/// One row per business per day. A counter, not an analytics pipeline —
/// Phase 1's dashboard only needs 7- and 30-day totals.
model MenuView {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  viewedOn   DateTime @map("viewed_on") @db.Date
  count      Int      @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, viewedOn])
  @@map("menu_views")
}

// ─── Phase 2: table ordering ─────────────────────────────────────────────────

enum OrderStatus {
  placed
  /// Staff have seen it and taken it on. The diner's screen says so within a
  /// second; the kitchen has not necessarily started work.
  accepted
  preparing
  ready
  completed
  cancelled
}

model Table {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// "12", "Balcony 3", "Screen 2 Row F" — whatever staff call it.
  label      String
  /// 32 hex chars, printed on this table's card and never changed. The card
  /// is the only place it exists, which is what makes holding it equivalent
  /// to sitting at the table.
  token      String   @unique
  position   Int
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]
  notifications Notification[]

  @@index([businessId, position])
  @@map("tables")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @map("business_id") @db.Uuid
  tableId     String      @map("table_id") @db.Uuid
  status      OrderStatus @default(placed)
  /// Business day and a per-day counter: what staff actually call out. An
  /// order id is unusable across a pass.
  businessDay DateTime    @map("business_day") @db.Date
  dailyNumber Int         @map("daily_number")
  placedAt    DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(6)
  /// This table ordered again inside the business's running-order window —
  /// they are mid-meal, not newly seated. Written once, when the order is
  /// created, and never recomputed: shortening the window tomorrow must not
  /// un-flag an order that was a genuine return today. Staff can clear it.
  isRunning   Boolean     @default(false) @map("is_running")
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  note        String?

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table    Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  events   OrderEvent[]
  bill     Bill?
  rating   OrderRating?
  notifications Notification[]
  cancellations OrderItemCancellation[]

  @@unique([businessId, businessDay, dailyNumber])
  @@index([businessId, status])
  @@index([tableId, status])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  /// Kept for sales reporting, nulled if the dish is later deleted. Never
  /// authoritative for price — see the snapshot columns below.
  menuItemId String? @map("menu_item_id") @db.Uuid

  /// What the menu said at the moment this was ordered. A price change at
  /// 3pm must not alter what a table that ordered at 2pm is charged.
  nameSnapshot    String  @map("name_snapshot")
  variantSnapshot String? @map("variant_snapshot")
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)

  quantity  Int
  /// Which round this arrived in, so staff can see what is new.
  batch     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cancellations OrderItemCancellation[]

  @@index([orderId, batch])
  @@index([businessId])
  @@map("order_items")
}

enum CancellationReason {
  mistake
  changed_mind
  wrong_item
  too_slow
  other
}

enum CancelledBy {
  diner
  staff
}

/// One cancellation of one line, counted in units.
///
/// The ledger exists because `order_items` deliberately does not remember:
/// cancelling decrements the line's quantity, and a line cancelled to nothing
/// is deleted outright. That keeps every existing reader — the bill above all
/// — correct without any of them learning what a cancellation is. The price
/// of that is that the history has to live somewhere, and this is it, which
/// is why the row carries its own snapshots rather than reading them back
/// through `orderItemId`.
model OrderItemCancellation {
  id          String  @id @default(uuid()) @db.Uuid
  businessId  String  @map("business_id") @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  /// Null once the line it came from was cancelled in full and removed.
  orderItemId String? @map("order_item_id") @db.Uuid

  /// How many units went. The line keeps whatever is still live.
  quantity Int

  nameSnapshot    String  @map("name_snapshot")
  variantSnapshot String? @map("variant_snapshot")
  unitPrice       Decimal @map("unit_price") @db.Decimal(10, 2)

  reason      CancellationReason
  /// Free text the diner may add, and must add when the reason is `other`.
  remark      String?
  cancelledBy CancelledBy @default(diner) @map("cancelled_by")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([businessId, createdAt])
  @@map("order_item_cancellations")
}

/// One thing that happened to an order, in the order it happened.
///
/// Written by two authors: `place_table_round` logs the round (it is the only
/// thing that knows its contents), and an AFTER UPDATE trigger on `orders`
/// logs every status change. Read by both screens and never updated.
model OrderEvent {
  id         BigInt   @id @default(autoincrement())
  orderId    String   @map("order_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// A status name, or "round_added". Text rather than the enum: most future
  /// kinds are not statuses.
  kind       String
  data       Json     @default("{}")
  at         DateTime @default(now()) @db.Timestamptz(6)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([orderId, id])
  @@map("order_events")
}


// ─── Phase 3: bills and ratings ──────────────────────────────────────────────

/// Written once. Regenerating returns the existing row rather than recomputing,
/// because the point of snapshotting is that tomorrow's price change cannot
/// alter a bill printed today.
model Bill {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  /// Sequential per business. Not a GST invoice number — see the Phase 3 spec.
  billNumber  Int      @map("bill_number")
  /// Snapshot: the table may be renamed or deleted later.
  tableLabel  String   @map("table_label")
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  currency    String   @default("INR")

  // The configuration that produced these numbers, frozen.
  pricesIncludeTax  Boolean @map("prices_include_tax")
  taxLabel          String  @map("tax_label")
  serviceChargeRate Decimal @map("service_charge_rate") @db.Decimal(5, 2)
  /// name, address, gstin, logo path — everything needed to reprint later.
  businessSnapshot  Json    @map("business_snapshot")
  receiptFooter     String? @map("receipt_footer")

  subtotal      Decimal @db.Decimal(10, 2)
  taxTotal      Decimal @map("tax_total") @db.Decimal(10, 2)
  serviceCharge Decimal @map("service_charge") @db.Decimal(10, 2)
  roundOff      Decimal @map("round_off") @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines    BillLine[]

  @@unique([businessId, billNumber])
  @@index([businessId, issuedAt])
  @@map("bills")
}

model BillLine {
  id         String  @id @default(uuid()) @db.Uuid
  billId     String  @map("bill_id") @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  name       String
  variant    String?
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  /// Gross, as the menu displayed it.
  lineTotal  Decimal @map("line_total") @db.Decimal(10, 2)
  lineNet    Decimal @map("line_net") @db.Decimal(10, 2)
  taxRate    Decimal @map("tax_rate") @db.Decimal(5, 2)
  taxAmount  Decimal @map("tax_amount") @db.Decimal(10, 2)
  position   Int

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, position])
  @@index([businessId])
  @@map("bill_lines")
}

/// Suggested review texts. A row with a null businessId is a platform default;
/// an owner can add their own.
model ReviewPrompt {
  id           String  @id @default(uuid()) @db.Uuid
  businessId   String? @map("business_id") @db.Uuid
  businessType String? @map("business_type")
  /// 'low' (1-3) | 'good' (4) | 'great' (5)
  ratingBand   String  @map("rating_band")
  text         String
  position     Int     @default(0)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, ratingBand])
  @@map("review_prompts")
}

/// Our own rating, captured in our own UI. Useful to the owner whether or not
/// the diner ever reaches Google.
model OrderRating {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  orderId         String   @unique @map("order_id") @db.Uuid
  tableId         String   @map("table_id") @db.Uuid
  stars           Int
  promptId        String?  @map("prompt_id") @db.Uuid
  privateFeedback String?  @map("private_feedback")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("order_ratings")
}


// ─── Phase 4: QR merchandise ─────────────────────────────────────────────────

enum MerchStatus {
  requested
  quoted
  confirmed
  in_production
  shipped
  delivered
  cancelled
}

/// Platform catalogue. No businessId: everyone orders from the same list at
/// the same prices, and we are the only seller.
model MerchProduct {
  id           String  @id @default(uuid()) @db.Uuid
  sku          String  @unique
  name         String
  blurb        String
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  currency     String  @default("INR")
  minQuantity  Int     @default(1) @map("min_quantity")
  leadTimeDays Int     @default(7) @map("lead_time_days")
  /// True when the product needs one card per table rather than one per order.
  perTable     Boolean @default(true) @map("per_table")
  isActive     Boolean @default(true) @map("is_active")
  position     Int     @default(0)

  items MerchOrderItem[]

  @@map("merch_products")
}

model MerchOrder {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @map("business_id") @db.Uuid
  /// Platform-wide sequential. What we quote and invoice against offline.
  orderNumber Int         @unique @map("order_number")
  status      MerchStatus @default(requested)

  contactName  String  @map("contact_name")
  contactPhone String  @map("contact_phone")
  contactEmail String? @map("contact_email")

  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  state        String
  postalCode   String  @map("postal_code")
  country      String  @default("IN")

  /// From the owner.
  notes          String?  @map("notes")
  /// Ours. Never returned to an owner — RLS is row-level, so this is withheld
  /// in the API's owner-facing shape instead.
  adminNotes     String?  @map("admin_notes")
  quotedTotal    Decimal? @map("quoted_total") @db.Decimal(10, 2)
  /// Catalogue arithmetic at request time, so the owner sees a number before
  /// we quote. Not a price we are bound to.
  estimatedTotal Decimal  @map("estimated_total") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    MerchOrderItem[]

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("merch_orders")
}

model MerchOrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  /// Which tables' codes to print. Empty means the venue card instead of table
  /// cards. A PVC card is per-table, so "20 cards" without saying which tables
  /// is not a fulfillable order.
  tableIds  String[] @map("table_ids") @db.Uuid

  order   MerchOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product MerchProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("merch_order_items")
}

/// The staff inbox.
///
/// Diners deliberately have no equivalent: they need their current order,
/// not a history, and `get_table_order` already returns that. Everything
/// here is therefore staff-facing, which is why there is no audience column.
model Notification {
  /// Identity and cursor in one column. Clients refetch `?since=<id>` on
  /// every wake-up — reconnect, tab focus, fallback poll — so a broadcast
  /// that never arrived costs nothing. BigInt rather than Int because the
  /// counter is global across tenants; it is narrowed to a JS number at the
  /// API boundary, which is exact far past anything a serial4 would hold.
  id         BigInt    @id @default(autoincrement())
  businessId String    @map("business_id") @db.Uuid
  orderId    String?   @map("order_id") @db.Uuid
  tableId    String?   @map("table_id") @db.Uuid
  /// "order.placed", "order.round_added". Kept as text, not an enum: adding
  /// a kind should not need a migration on a table that is pure append.
  kind       String
  /// Rendered once, at emit time, by notifications/events.ts. The toast, the
  /// bell row and the pushed notification all read these same two strings,
  /// so they cannot drift into describing the same event differently.
  title      String
  body       String
  data       Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  table    Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([businessId, id])
  @@map("notifications")
}

/// One row per browser that agreed to be pushed to. Per device, not per
/// user: an owner with a counter tablet and a phone has two.
model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// The push service's URL for this device. Unique because re-subscribing
  /// the same browser must update the row, not accumulate duplicates that
  /// each deliver the same notification.
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
