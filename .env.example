# ─── Database ────────────────────────────────────────────────────────────────
# Local dev via `pnpm db:up` (docker compose). Swap for the Supabase pooled
# connection string when you have it.
DATABASE_URL="postgresql://menu:menu@localhost:5433/menu?schema=public"

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
PUBLIC_MENU_BASE_URL="http://localhost:3000"

# Rotate these before any real deployment.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
REVALIDATE_SECRET="dev-revalidate-secret-change-me"
TABLE_SESSION_SECRET="dev-table-session-secret-change-me"

# ─── Auth behaviour ──────────────────────────────────────────────────────────
# No WhatsApp/email credentials yet: OTPs are logged to the console and new
# accounts are marked verified on signup. Set to false once drivers are wired.
AUTH_SKIP_VERIFICATION=true

# ─── Storage ─────────────────────────────────────────────────────────────────
# Leave SUPABASE_URL empty to use the local disk driver (uploads to
# apps/api/.uploads, served from the API). Fill in to use Supabase Storage.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="business-assets"

# ─── Cloudinary (preferred for images when set) ───────────────────────────────
# Takes precedence over Supabase Storage. Worth it for the delivery-time
# transform: the same upload is served as AVIF or WebP at a sensible quality
# depending on the diner's phone. Browser uploads straight to Cloudinary with a
# signature the API mints, so bytes never pass through us.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# The cloud name again, for the dashboard's own image URLs. Public by design —
# it appears in every delivery URL. Never expose the API secret this way.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Notification providers (inert until filled) ─────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_OTP_TEMPLATE="otp_verification"
RESEND_API_KEY=""
RESEND_FROM="Menu <noreply@menu.irad.solutions>"

# ─── Seed platform admin ─────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@irad.solutions"
SEED_ADMIN_PIN="204815"
SEED_ADMIN_NAME="Platform Admin"

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_NAME="menu.irad.solutions"

# Runtime role: MUST be a non-superuser, or RLS silently does nothing.
APP_DATABASE_URL="postgresql://menu_app:menu_app@localhost:5433/menu?schema=public"
